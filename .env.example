# ─────────────────────────────────────────────────────────────────────────
#  Ejemplo de variables de entorno.
#  · En tu computadora: copia este archivo como ".env.local" y complétalo.
#  · En Vercel: cárgalas en Settings → Environment Variables.
#  NUNCA subas a GitHub el archivo con los valores reales.
# ─────────────────────────────────────────────────────────────────────────

# Conexión a PostgreSQL (Neon, Supabase, etc.). OBLIGATORIA.
# En Vercel se crea sola al conectar una base Neon desde la pestaña Storage.
DATABASE_URL=postgresql://usuario:contraseña@servidor/basededatos?sslmode=require

# Contraseña del panel /admin. Si la dejas vacía, se crea la primera vez que entras.
ADMIN_PASSWORD=

# Texto largo y al azar (por ej. 40 letras y números) para firmar las sesiones del panel.
SESSION_SECRET=

# Dirección pública del sitio (se usa en el sitemap para Google).
NEXT_PUBLIC_SITE_URL=https://jomerarte.com

# Opcional: Vercel Blob para subir videos y archivos grandes.
# Se crea sola al conectar un "Blob store" desde la pestaña Storage de Vercel.
BLOB_READ_WRITE_TOKEN=

# Opcional: precios automáticos de Mercado Libre (también se pueden cargar en /admin/mercadolibre).
ML_CLIENT_ID=
ML_CLIENT_SECRET=

# Recomendado: protege la actualización automática diaria (Vercel la envía sola al cron).
CRON_SECRET=
