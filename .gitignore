# ───────────────────────────────────────────────────────────────
#  Archivos que NO se suben a GitHub
#  (Vercel instala las dependencias y compila el sitio solo)
# ───────────────────────────────────────────────────────────────

# Dependencias (miles de archivos: se instalan con "npm install")
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Resultado de compilar ("npm run build"): Vercel lo genera en cada despliegue
/.next/
/out/
/build
/coverage

# Variables de entorno: tienen contraseñas. Se cargan en Vercel → Settings → Environment Variables
.env
.env.*
!.env.example

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Sistema y registros
.DS_Store
Thumbs.db
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
